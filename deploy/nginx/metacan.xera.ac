# MetaCan nginx vhost. Proxies to the Next.js server pm2 runs on :3111.
#
# deploy/deploy.sh copies this file to the server's home directory on every run,
# so the path below is always a fresh copy of this file. It is not read out of
# /var/www/metacan: that directory is now the application itself, a checkout of
# the deploy branch, and it does not contain this repo's deploy/ directory.
#
# Install (needs root):
#   sudo cp ~/metacan-rate-limits.conf /etc/nginx/conf.d/metacan-rate-limits.conf
#   sudo cp ~/metacan-app.conf /etc/nginx/snippets/metacan-app.conf
#   sudo cp ~/metacan.xera.ac.nginx /etc/nginx/sites-available/metacan.xera.ac
#   sudo ln -sfn /etc/nginx/sites-available/metacan.xera.ac /etc/nginx/sites-enabled/metacan.xera.ac
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d metacan.xera.ac --agree-tos -m ahmad.pub@gmail.com --redirect
#
# This file is HTTP-only on purpose. certbot --nginx rewrites it in place, adding
# the listen 443 block, the certificate paths and the 80 to 443 redirect, exactly
# as it did for the sibling sites on this box. Writing the TLS block by hand here
# would collide with the one certbot generates.

# IPv4 only, exactly like every sibling vhost on this box. This is deliberate.
# metacan.xera.ac is an A record, and no other vhost here binds [::]:80. If this
# file were the only one to bind it, nginx would make this server block the
# DEFAULT for IPv6 port 80, and an IPv6 request for any OTHER xera.ac site would
# land on MetaCan. Matching the siblings avoids that entirely.
server {
    listen 80;
    server_name metacan.xera.ac;

    include /etc/nginx/snippets/metacan-app.conf;
}
