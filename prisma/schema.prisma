// MetaCan. Introspected from deploy/schema.sql, which is the source of truth:
// the tables are created by that file and loaded by COPY, because Prisma's
// migration engine is not the right tool for a 4.3M-row bulk import.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The frame: every Canadian work in the pinned OpenAlex snapshot (all 482
/// partitions). No abstract column by design; the abstract inverted indexes are
/// 8.6 GB of the frame's 9.3 GB of text, and the host has 13 GB free, so the
/// detail page fetches an abstract live from OpenAlex. `hasAbstract` IS stored,
/// because whether a work has one is itself a finding: 23.3% do not, and the
/// screen finds half as much metaresearch there.
model Work {
  id           String   @id @db.VarChar(20)
  /// TEXT, not VarChar(255): the longest DOI in the frame is 294 characters (a
  /// malformed OpenAlex record, a PDF URL glued to a DOI prefix). See schema.sql.
  doi          String?
  title        String
  year         Int?     @db.SmallInt
  lang         String?  @db.VarChar(8)
  type         String?  @db.VarChar(32)
  venue        String?
  topic        String?
  field        String?
  citedBy      Int      @default(0) @map("cited_by")
  isRetracted  Boolean  @default(false) @map("is_retracted")
  hasAbstract  Boolean  @default(false) @map("has_abstract")

  /// PROVENANCE. Why is this work in the frame? A frame that forgets how it
  /// found something cannot be audited, and that is the entire thesis.
  routeCaAff   Boolean  @default(false) @map("route_ca_aff")
  routeCaFund  Boolean  @default(false) @map("route_ca_fund")
  routeCaVenue Boolean  @default(false) @map("route_ca_venue")
  routeAboutCa Boolean  @default(false) @map("route_about_ca")

  caInstitutions String? @map("ca_institutions")
  funders        String?
  keywords       String?

  retraction Retraction?
  screened   Screened?
  score      WorkScore?
  prediction WorkPrediction?
  labels     WorkLabel[]
  authors    WorkAuthor[]

  @@map("works")
}

/// The author layer (deploy/authors.sql): harvested from the frame's own
/// pinned OpenAlex release and loaded by COPY like everything else. Queries
/// go through raw SQL (the expression GIN name index has no Prisma spelling);
/// these models exist so the schema file stays a complete map of the database.
model Author {
  id      String @id @db.VarChar(20)
  name    String
  works   Int
  caWorks Int    @map("ca_works")

  workAuthors WorkAuthor[]

  @@map("authors")
}

/// One authorship. `isCa` belongs to the WORK-AUTHOR PAIR, not the person:
/// the same researcher can be Canadian-affiliated on one work and not another,
/// and the Canada-only collaboration network is built on exactly that.
model WorkAuthor {
  workId   String  @map("work_id") @db.VarChar(20)
  authorId String  @map("author_id") @db.VarChar(20)
  position Int     @db.SmallInt
  isCa     Boolean @map("is_ca")

  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id])

  @@id([workId, position])
  @@map("work_author")
}

/// Retraction Watch's post-publication state (finding 17). Separate from
/// `Work.isRetracted` ON PURPOSE: OpenAlex's flag is a boolean over a state
/// space with at least four values, so it expresses "retracted" and silently
/// reports expression-of-concern, correction and reinstatement as false, which
/// reads as "fine". `openalexFlagged = false` means OpenAlex missed it.
model Retraction {
  workId          String  @id @map("work_id") @db.VarChar(20)
  nature          String? @db.VarChar(64)
  reason          String?
  retractionDate  String? @map("retraction_date") @db.VarChar(32)
  openalexFlagged Boolean @map("openalex_flagged")

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@map("retractions")
}

/// The three-model screen: 1,000 works drawn from the real frame with KNOWN
/// selection probabilities, screened by Opus 4.8, GPT-5.6 (high) and Grok 4.5
/// against one locked rubric on its full eight-field payload.
///
/// `nIn` (0..3) is the most honest column in this database. Of the works ANY
/// model called metaresearch, only 37% were called metaresearch by all three.
/// `weight` is the design weight; the sample is stratified, so any rate computed
/// from it without the weight is wrong.
model Screened {
  id        String  @id @db.VarChar(20)
  stratum   String? @db.VarChar(32)
  stratumN  Int?    @map("stratum_n")
  weight    Float?
  title     String?
  abstract  String?
  year      Int?    @db.SmallInt
  lang      String? @db.VarChar(8)
  type      String? @db.VarChar(32)
  venue     String?
  topic     String?
  field     String?

  opusTier       String? @map("opus_tier") @db.VarChar(8)
  opusGenre      String? @map("opus_genre") @db.VarChar(48)
  opusAboutCa    Boolean? @map("opus_about_ca")
  opusConfidence String? @map("opus_confidence") @db.VarChar(8)
  opusReason     String? @map("opus_reason")

  gptTier       String? @map("gpt_tier") @db.VarChar(8)
  gptGenre      String? @map("gpt_genre") @db.VarChar(48)
  gptAboutCa    Boolean? @map("gpt_about_ca")
  gptConfidence String? @map("gpt_confidence") @db.VarChar(8)
  gptReason     String? @map("gpt_reason")

  grokTier       String? @map("grok_tier") @db.VarChar(8)
  grokGenre      String? @map("grok_genre") @db.VarChar(48)
  grokAboutCa    Boolean? @map("grok_about_ca")
  grokConfidence String? @map("grok_confidence") @db.VarChar(8)
  grokReason     String? @map("grok_reason")

  nIn Int? @map("n_in") @db.SmallInt

  work Work @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("screened")
}

/// The PROVISIONAL baseline frame scores: the two teacher heads of the distilled
/// student model (Opus and GPT; Grok was retired from the panel at D36) read over
/// all 4,299,418 works. The model is NOT mature (pilot/results/maturity.json:
/// passed = false after 7 training rounds), and `validationStatus` says so on
/// every row, verbatim: score_only:v0-immature-baseline. A score ORDERS works for
/// review; it never asserts a category, and no surface that reads this model may
/// present these numbers as validated labels.
model WorkScore {
  id               String  @id @db.VarChar(20)
  scoreOpus        Float?  @map("score_opus")
  scoreGpt         Float?  @map("score_gpt")
  /// |scoreOpus - scoreGpt|: the teachers' disagreement on this work.
  scoreSpread      Float?  @map("score_spread")
  /// Verbatim from the scoring run. Nothing downstream may soften it.
  validationStatus String? @map("validation_status")

  work Work @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("work_score")
}

/// Per-model category and study-design labels from the labelling rounds under
/// pilot/screening/loop (one round_NNN directory per round), loaded by
/// deploy/load_labels.py. MACHINE LABELS from frontier LLMs, unvalidated, and
/// SPARSE ON PURPOSE: only a few
/// hundred works carry rows today. Nothing that reads this table may treat an
/// absent row as a negative label, and every surface that filters on it must
/// say how many works in the cohort carry labels at all.
model WorkLabel {
  id            String   @db.VarChar(20)
  /// opus | gpt | grok
  model         String   @db.VarChar(16)
  /// A set, not a single value: a work can be metaresearch AND open_science.
  /// insufficient_payload means the model refused to judge on the evidence.
  categories    String[]
  domain        String?  @db.VarChar(24)
  /// No study_design here is MEDLINE-validated yet; when that validation lands
  /// it will be carried explicitly, never assumed.
  studyDesign   String?  @map("study_design") @db.VarChar(32)
  genre         String?  @db.VarChar(16)
  aboutCaSystem Boolean? @map("about_ca_system")
  aboutCaTopic  Boolean? @map("about_ca_topic")
  confidence    String?  @db.VarChar(8)

  work Work @relation(fields: [id], references: [id], onDelete: Cascade)

  @@id([id, model])
  @@map("work_label")
}

/// One checkpointed distillation result for every work in the frame. These are
/// machine predictions learned from the Codex and Gemma direct label sets. They
/// are never interchangeable with WorkLabel rows and carry their unvalidated
/// status on every record.
model WorkPrediction {
  id                            String   @id @db.VarChar(20)
  modelVersion                  String   @map("model_version")
  candidateCategories           String[] @map("candidate_categories")
  consensusCategories           String[] @map("consensus_categories")
  categoryScoresCodex           Float[]  @map("category_scores_codex")
  categoryScoresGemma           Float[]  @map("category_scores_gemma")
  aboutCaSystemCandidate        Boolean  @map("about_ca_system_candidate")
  aboutCaSystemConsensus        Boolean  @map("about_ca_system_consensus")
  aboutCaSystemScoreCodex       Float    @map("about_ca_system_score_codex")
  aboutCaSystemScoreGemma       Float    @map("about_ca_system_score_gemma")
  aboutCaTopicCandidate         Boolean  @map("about_ca_topic_candidate")
  aboutCaTopicConsensus         Boolean  @map("about_ca_topic_consensus")
  aboutCaTopicScoreCodex        Float    @map("about_ca_topic_score_codex")
  aboutCaTopicScoreGemma        Float    @map("about_ca_topic_score_gemma")
  domainScoresCodex             Float[]  @map("domain_scores_codex")
  domainScoresGemma             Float[]  @map("domain_scores_gemma")
  domainCodex                   String?  @map("domain_codex") @db.VarChar(24)
  domainGemma                   String?  @map("domain_gemma") @db.VarChar(24)
  domainCandidate               String?  @map("domain_candidate") @db.VarChar(24)
  domainConsensus               String?  @map("domain_consensus") @db.VarChar(24)
  studyDesignCodex              String   @map("study_design_codex") @db.VarChar(32)
  studyDesignGemma              String   @map("study_design_gemma") @db.VarChar(32)
  studyDesignScoresCodex        Float[]  @map("study_design_scores_codex")
  studyDesignScoresGemma        Float[]  @map("study_design_scores_gemma")
  studyDesignCandidate          String   @map("study_design_candidate") @db.VarChar(32)
  studyDesignConsensus          String?  @map("study_design_consensus") @db.VarChar(32)
  genreCodex                    String   @map("genre_codex") @db.VarChar(16)
  genreGemma                    String   @map("genre_gemma") @db.VarChar(16)
  genreScoresCodex              Float[]  @map("genre_scores_codex")
  genreScoresGemma              Float[]  @map("genre_scores_gemma")
  genreCandidate                String   @map("genre_candidate") @db.VarChar(16)
  genreConsensus                String?  @map("genre_consensus") @db.VarChar(16)
  teacherDisagreementScore      Float    @map("teacher_disagreement_score")
  thresholdUncertaintyScore     Float    @map("threshold_uncertainty_score")
  predictionStatus              String   @map("prediction_status")

  work Work @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([modelVersion])
  @@index([studyDesignCandidate])
  @@index([studyDesignConsensus])
  @@index([domainCandidate])
  @@index([domainConsensus])
  @@map("work_prediction")
}

/// Citable cohort queries: the canonical filter state behind /q/<hash>. The row
/// stores the FILTERS, never the results; the page recomputes counts live,
/// because re-running the query against the pinned snapshot is the honest way
/// to reproduce them.
model QueryPermalink {
  hash      String   @id @db.VarChar(16)
  filters   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("query_permalink")
}

/// The LIVE LAYER: recent Canadian works synced daily from the OpenAlex API by
/// the server-side sync job, visibly separate from the frozen frame. These rows
/// carry no classifier output and never will until a classifier passes human
/// validation; the recent page and /api/v1/recent read them as-is.
model RecentWork {
  id                  String    @id @db.VarChar(20)
  doi                 String?
  title               String
  publicationDate     DateTime  @map("publication_date") @db.Date
  year                Int?      @db.SmallInt
  lang                String?   @db.VarChar(8)
  type                String?   @db.VarChar(32)
  venue               String?
  topic               String?
  field               String?
  citedBy             Int       @default(0) @map("cited_by")
  isRetracted         Boolean   @default(false) @map("is_retracted")
  hasAbstract         Boolean   @default(false) @map("has_abstract")
  abstract            String?
  pmid                String?   @db.VarChar(32)
  pmcid               String?   @db.VarChar(32)
  routeCaAff          Boolean   @default(false) @map("route_ca_aff")
  routeCaFund         Boolean   @default(false) @map("route_ca_fund")
  routeCaVenue        Boolean   @default(false) @map("route_ca_venue")
  routeAboutCa        Boolean   @default(false) @map("route_about_ca")
  caInstitutions      String[]  @map("ca_institutions")
  funders             String[]
  keywords            String[]
  authors             Json
  openalexUpdatedDate DateTime? @map("openalex_updated_date") @db.Date
  routeVersion        String    @map("route_version") @db.VarChar(64)
  sourceWindowStart   DateTime  @map("source_window_start") @db.Date
  sourceWindowEnd     DateTime  @map("source_window_end") @db.Date
  firstSeenAt         DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt          DateTime  @map("last_seen_at") @db.Timestamptz(6)
  syncedAt            DateTime  @map("synced_at") @db.Timestamptz(6)

  @@index([publicationDate(sort: Desc), id])
  @@map("recent_work")
}

/// One row per sync attempt, successful or not. The recent page reports the
/// latest run's status verbatim: a failed sync is shown as failed, never
/// papered over with the previous success's numbers.
model RecentSyncRun {
  id            BigInt    @id @default(autoincrement())
  status        String    @db.VarChar(16)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  requestedDays Int       @map("requested_days")
  windowStart   DateTime  @map("window_start") @db.Date
  windowEnd     DateTime  @map("window_end") @db.Date
  routeVersion  String    @map("route_version") @db.VarChar(64)
  apiRequests   Int       @default(0) @map("api_requests")
  returnedRows  Int       @default(0) @map("returned_rows")
  candidateRows Int       @default(0) @map("candidate_rows")
  matchedRows   Int       @default(0) @map("matched_rows")
  storedRows    Int       @default(0) @map("stored_rows")
  error         String?

  @@index([startedAt(sort: Desc)])
  @@map("recent_sync_run")
}
