{
  "name": "metacan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3111}",
    "type-check": "tsc --noEmit",
    "sync:recent": "node scripts/sync-recent-openalex.mjs",
    "test:recent-sync": "node --test scripts/test/recent-openalex.test.mjs",
    "test:content": "tsx --test src/lib/content.test.ts",
    "db:preflight": "node scripts/check-prisma-baseline.mjs",
    "db:refresh-facets": "node scripts/refresh-facets.mjs",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "html-entities": "^2.6.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.20",
    "next-themes": "^0.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
